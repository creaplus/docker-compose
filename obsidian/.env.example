CONTAINER_NAME=obsidian

# Obsidian 数据根目录，直接挂到容器 /config（家目录 + Vault）
DATA_PATH=$PWD

# 宿主机用户，用 `id` 查看；需与数据目录属主一致，避免权限问题
PUID=1000
PGID=1000

TZ=Asia/Shanghai
LC_ALL=zh_CN.UTF-8
TITLE=Obsidian

# HTTP（须反代才建议对外）；HTTPS 为浏览器完整功能入口
PORT=3005
HTTPS_PORT=3006

# 容器内置 HTTP Basic Auth（必填）。Nginx 只做 TLS / 反代，不要再配一层 auth_basic
CUSTOM_USER=obsidian
PASSWORD=
